<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Nightly backup (backup.mjs), daily at 21:00: one .tgz of the application packages, drafts,
  state files, personal config and launchd plists — everything git does not hold — into
  iCloud Drive (or BACKUP_DIR). 21:00 rather than the small hours: a laptop is awake then.
  Replace YOUR_USERNAME (launchd needs absolute paths). Install/uninstall: docs/setup.md → "Schedule it (launchd)".
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.example.backup</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/YOUR_USERNAME/linkedin-assistant/run.sh</string> <!-- sets PATH (launchd strips it), daily log + rotation -->
    <string>backup.mjs</string>
  </array>
  <!-- Uncomment to back up somewhere other than iCloud Drive:
  <key>EnvironmentVariables</key>
  <dict><key>BACKUP_DIR</key><string>/Volumes/Backup/linkedin-assistant</string></dict>
  -->
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>21</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>/Users/YOUR_USERNAME/linkedin-assistant/logs/backup.out.log</string>
  <key>StandardErrorPath</key><string>/Users/YOUR_USERNAME/linkedin-assistant/logs/backup.err.log</string>
</dict>
</plist>
