#!/bin/bash
# Wrapper for scheduled runs (launchd/cron strip your PATH, so set it explicitly).
# Copy to run.sh and fill in your own values (run.sh is gitignored).
set -euo pipefail

# Point this at the node that has playwright installed (adjust the version).
export PATH="$HOME/.nvm/versions/node/<YOUR_NODE_VERSION>/bin:/usr/bin:/bin:/usr/sbin:/sbin"

cd "$(dirname "$0")"
mkdir -p logs   # fresh clones lack logs/; set -e would kill the run on the redirect
find "$PWD/logs" -name '*.log' -mtime +30 -delete 2>/dev/null || true   # log rotation
STAMP="$(date +%Y%m%d_%H%M%S)"
# Keep your resume path in one place for the draft attach hint.
export RESUME_PATH="$HOME/Downloads/your-resume.docx"
# Your name for the cover-note / reply signature.
export CANDIDATE_NAME="Your Name"

node check.mjs >> "logs/run_${STAMP}.log" 2>&1
echo "log: logs/run_${STAMP}.log"
