#!/usr/bin/env bash
# One wrapper for every scheduled script (launchd strips PATH, so it is set here).
#   run.sh check.mjs                 LinkedIn inbox check      → logs/check_YYYYMMDD.log
#   run.sh jobs.mjs                  full job discovery        → logs/jobs_YYYYMMDD.log
#   DOU_ONLY=1 run.sh jobs.mjs       RSS/board-only discovery  → logs/jobs_dou_YYYYMMDD.log
#   run.sh djinni-check.mjs          Djinni inbox check        → logs/djinni-check_YYYYMMDD.log
# Copy to run.sh and fill in your own values (run.sh is gitignored).
set -euo pipefail

# Point this at the node that has playwright installed (adjust the version).
# ~/.local/bin holds the claude CLI (LLM re-scoring).
export PATH="$HOME/.local/bin:$HOME/.nvm/versions/node/<YOUR_NODE_VERSION>/bin:/usr/bin:/bin:/usr/sbin:/sbin"
export RESUME_PATH="$HOME/Downloads/your-resume.docx"   # attach hint in drafts and packages
export CANDIDATE_NAME="Your Name"                       # signature in drafts and cover notes

cd "$(dirname "$0")"
mkdir -p -m 700 logs   # fresh clones lack logs/; set -e would kill the run on the redirect. 700: logs quote job/recruiter text (mode applies only when this call creates it)
find "$PWD/logs" -name '*.log' ! -name 'state-server.log' ! -name 'jobs-badge.*.log' -mtime +30 -delete 2>/dev/null || true   # log rotation (launchd holds the server's and the badge daemon's logs open)
# The two logs the rotation above must skip are the two launchd holds open, and
# nothing else bounded them: state-server exits on EADDRINUSE and KeepAlive
# restarts it, so its log grew forever. Truncate in place — deleting an open
# file would leave the daemon writing to an unlinked inode.
for f in "$PWD/logs/state-server.log" "$PWD"/logs/jobs-badge.*.log; do
  if [[ -f "$f" ]] && [[ "$(stat -f%z "$f" 2>/dev/null || echo 0)" -gt 10485760 ]]; then
    : > "$f"
  fi
done
find "$PWD/applications/archive" -name '*.md' -mtime +180 -delete 2>/dev/null || true   # archived packages: nothing reads them

SCRIPT="${1:?usage: run.sh <script.mjs> [args]}"; SCRIPT="${SCRIPT##*/}"
DOU="$([[ "${DOU_ONLY:-}" == 1 ]] && echo _dou || true)"   # jobs.mjs honours only DOU_ONLY=1; DOU_ONLY=0 is a full run
LOG="logs/${SCRIPT%.mjs}${DOU}_$(date +%Y%m%d).log"   # one file per day; each run appends after a "=== run" separator
# caffeinate: launchd fires a missed schedule inside a short DarkWake and the Mac
# sleeps again under the run — timers pause and a 1-minute run stretches to an hour.
# -i keeps the system awake while the script runs; -s adds a hard hold on AC power.
{ echo "=== run $(date -u +%FT%TZ) ==="; caffeinate -i -s node "$@"; } >> "$LOG" 2>&1
echo "log: $LOG"
