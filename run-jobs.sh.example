#!/bin/bash
# Wrapper for scheduled job discovery. Arg: "dou" (RSS only) or "full" (DOU + LinkedIn).
# Copy to run-jobs.sh and fill in your own values (run-jobs.sh is gitignored).
set -euo pipefail

export PATH="$HOME/.nvm/versions/node/<YOUR_NODE_VERSION>/bin:/usr/bin:/bin:/usr/sbin:/sbin"
cd "$(dirname "$0")"
export RESUME_PATH="$HOME/Downloads/your-resume.docx"
export CANDIDATE_NAME="Your Name"
# Free Jooble API key from https://jooble.org/api/about (only needed if jooble.enabled in jobs.config.json)
export JOOBLE_API_KEY="your-jooble-api-key"

mkdir -p logs   # fresh clones lack logs/; set -e would kill the run on the redirect
MODE="${1:-full}"
STAMP="$(date +%Y%m%d_%H%M%S)"

if [ "$MODE" = "dou" ]; then
  DOU_ONLY=1 node jobs.mjs >> "logs/jobs_dou_${STAMP}.log" 2>&1
else
  node jobs.mjs >> "logs/jobs_full_${STAMP}.log" 2>&1
fi
