#!/usr/bin/env bash
# Wrapper for scheduled job discovery. Arg: "dou" (RSS only) or "full" (DOU + LinkedIn).
# Copy to run-jobs.sh and fill in your own values (run-jobs.sh is gitignored).
set -euo pipefail
# caffeinate: launchd fires a missed schedule inside a 7-second DarkWake and the
# Mac sleeps again under the run — timers pause, LinkedIn "searches" took 15–58
# minutes of wall clock, and the run lock then skipped the next hourly run.
# -i keeps the system awake while jobs.mjs runs; -s adds a hard hold on AC power.

export PATH="$HOME/.local/bin:$HOME/.nvm/versions/node/<YOUR_NODE_VERSION>/bin:/usr/bin:/bin:/usr/sbin:/sbin"   # ~/.local/bin holds the claude CLI (LLM re-scoring)
cd "$(dirname "$0")"
export RESUME_PATH="$HOME/Downloads/your-resume.docx"
export CANDIDATE_NAME="Your Name"
# Free Jooble API key from https://jooble.org/api/about (only needed if jooble.enabled in jobs.config.json)
export JOOBLE_API_KEY="your-jooble-api-key"

mkdir -p logs   # fresh clones lack logs/; set -e would kill the run on the redirect
find "$PWD/logs" -name '*.log' ! -name 'state-server.log' -mtime +30 -delete 2>/dev/null || true   # log rotation (the server holds its log open)
find "$PWD/applications/archive" -name '*.md' -mtime +180 -delete 2>/dev/null || true   # archived packages: nothing reads them; 6 months is plenty
MODE="${1:-full}"
STAMP="$(date +%Y%m%d)"   # one log file per day; each run appends after a "=== run" separator

if [ "$MODE" = "dou" ]; then
  { echo "=== run $(date -u +%FT%TZ) ==="; DOU_ONLY=1 caffeinate -i -s node jobs.mjs; } >> "logs/jobs_dou_${STAMP}.log" 2>&1
else
  { echo "=== run $(date -u +%FT%TZ) ==="; caffeinate -i -s node jobs.mjs; } >> "logs/jobs_full_${STAMP}.log" 2>&1
fi
