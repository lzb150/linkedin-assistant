<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Jobs.app badge daemon, started at login. `--background` = show the unread Dock badge only,
  do not open the dashboard. It MUST start through `open`: a bare binary exec gets
  "Notifications are not allowed" from macOS, so banners never show. `open -W` waits for the
  app, so KeepAlive restarts it when it exits. The sh loop first waits out an app that is
  already running: `open` on a running app arrives as a Dock-click reopen (opens the unread
  thread in the browser, clears the badge), and `launchctl kickstart -k` or unload stops only
  this job, never the app — stop the app with `pkill -f Jobs.app/Contents/MacOS/jobs`.
  `job[s]` keeps pgrep from matching this sh command line itself. With a WRONG path `open`
  fails and launchd respawns it every 10 s forever, so replace YOUR_USERNAME
  (launchd needs absolute paths) before loading. Install/uninstall: docs/setup.md → "Schedule it (launchd)".
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.example.jobs-badge</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>while pgrep -qf '/Users/YOUR_USERNAME/linkedin-assistant/Jobs.app/Contents/MacOS/job[s]'; do sleep 10; done; exec /usr/bin/open -W -g -a /Users/YOUR_USERNAME/linkedin-assistant/Jobs.app --args --background</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <!-- Relaunch whenever the daemon exits: `open -W` reports 0 even for a crash,
       so SuccessfulExit=false would never fire. -->
  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/YOUR_USERNAME/linkedin-assistant/logs/jobs-badge.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOUR_USERNAME/linkedin-assistant/logs/jobs-badge.err.log</string>
</dict>
</plist>
