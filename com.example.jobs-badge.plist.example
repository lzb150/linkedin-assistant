<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Jobs.app badge daemon, started at login. `--background` = show the unread Dock badge only,
  do not open the dashboard. `open -W` gives launchd a live pid; it exits 0 however the app
  ended, so KeepAlive is unconditional — with a WRONG path launchd respawns `open` every 10 s
  forever, so replace YOUR_USERNAME (launchd needs absolute paths) before loading. Install/uninstall: README → "Schedule it (launchd)".
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.example.jobs-badge</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/open</string>
    <string>-W</string>
    <string>-g</string>
    <string>-a</string>
    <string>/Users/YOUR_USERNAME/linkedin-assistant/Jobs.app</string>
    <string>--args</string>
    <string>--background</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <!-- Relaunch whenever the daemon exits: `open -W` reports 0 even for a crash,
       so SuccessfulExit=false would never fire. Stop it with launchctl unload. -->
  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/YOUR_USERNAME/linkedin-assistant/logs/jobs-badge.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOUR_USERNAME/linkedin-assistant/logs/jobs-badge.err.log</string>
</dict>
</plist>
