# Dependencies
node_modules/

# LinkedIn browser session (contains your logged-in cookies — never commit)
.browser-profile/

# Generated output
logs/
# …but keep the directory itself: launchd does not create parents for
# StandardOutPath, and state-server/jobs-badge never go through run.sh (the
# only mkdir -p logs), so on a fresh clone their logs went nowhere.
!logs/
logs/*
!logs/.gitkeep
drafts/
applications/

# Tracked job state (machine-local)
jobs-seen.json
source-health.json
seen.json

# Runtime Dock-badge state (written by check.mjs, read by Jobs.app)
notify-state.json

# macOS
.DS_Store

# Built Dock app bundle (machine-specific paths baked in; rebuild locally)
Jobs.app/

# Banner queue written by lib/notify.mjs, drained by Jobs.app
banners/

# Machine-specific run wrappers & launchd agents — use the *.example templates
run.sh
com.*.plist

# Personal resume — kept local only
resume.txt

# Local Claude Code settings (machine-specific)
.claude/

.idea

# Djinni browser session (contains your logged-in cookies — never commit)
.djinni-profile/

# Runtime Dock-badge state for Djinni (written by djinni-check.mjs, read by Jobs.app)
djinni-notify-state.json

# Ids of Djinni threads already notified about (written by djinni-check.mjs)
djinni-seen.json

# Profile-bump throttle state (written by djinni-check.mjs)
djinni-bump-state.json

# Dashboard job state and follow-up notify dedupe (machine-local runtime state)
job-state.json
followup-notify-state.json
followup-notify-state.json.tmp
job-state.*.bak
closed-check-state.json

# Browser-profile / run locks (lib/run-lock.mjs acquireProfileLock: `<name>.lock/` dirs)
.browser-profile.lock/
.djinni-profile.lock/
jobs-run.lock/
closed-check.lock/

# Atomic-write temp files and quarantined corrupt state files
*.tmp
*.corrupt

# Local tooling scratch dirs
.superpowers/
.playwright-cli/
run-stats.jsonl
