# Dependencies
node_modules/

# LinkedIn browser session (contains your logged-in cookies — never commit)
.browser-profile/

# Generated output
logs/
drafts/
applications/*.md
applications/index.html

# Tracked job state (machine-local)
jobs-seen.json
source-health.json
seen.json

# Runtime Dock-badge state (written by check.mjs, read by Jobs.app)
notify-state.json
notify-state.json.tmp

# Backup of the original AppleScript Jobs applet (kept local)
Jobs.app.orig/

# macOS
.DS_Store

# Built Dock app bundle (machine-specific paths baked in; rebuild locally)
Jobs.app/

# Built notification helper — rebuild with ./build-notifier.sh
Notifier.app/

# Machine-specific run wrappers & launchd agents — use the *.example templates
run.sh
run-jobs.sh
com.*.plist

# Machine-specific Windows wrappers & task registration — use the *.example templates
scripts/windows/run.ps1
scripts/windows/run-jobs.ps1
scripts/windows/register-tasks.ps1

# Personal resume — kept local only
resume.txt

# Local Claude Code settings (machine-specific)
.claude/

.idea

# Djinni browser session (contains your logged-in cookies — never commit)
.djinni-profile/

# Runtime Dock-badge state for Djinni (written by djinni-check.mjs, read by Jobs.app)
djinni-notify-state.json
djinni-notify-state.json.tmp

# Ids of Djinni threads already notified about (written by djinni-check.mjs)
djinni-seen.json

# Machine-specific Djinni run wrapper — use run-djinni.sh.example
run-djinni.sh

# Dashboard job state and follow-up notify dedupe (machine-local runtime state)
job-state.json
job-state.json.tmp
followup-notify-state.json
followup-notify-state.json.tmp
