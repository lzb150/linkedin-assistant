<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Djinni inbox check (run.sh djinni-check.mjs), hourly at :00. Writes djinni-notify-state.json,
  which the Jobs.app badge daemon sums with the LinkedIn count.
  Replace YOUR_USERNAME (launchd needs absolute paths). Install/uninstall: README → "Schedule it (launchd)".
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.example.djinni-inbox</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/YOUR_USERNAME/linkedin-assistant/run.sh</string>
    <string>djinni-check.mjs</string>
  </array>

  <!-- Runs every hour at minute 0 (00:00, 01:00, 02:00 ... 23:00). -->
  <key>StartCalendarInterval</key>
  <dict><key>Minute</key><integer>0</integer></dict>

  <key>StandardOutPath</key>
  <string>/Users/YOUR_USERNAME/linkedin-assistant/logs/djinni.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOUR_USERNAME/linkedin-assistant/logs/djinni.err.log</string>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
